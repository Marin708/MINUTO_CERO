; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="MINUTO CERO"
config/version="0.1.0"
run/main_scene="res://Scenes/UI/ClicParaEmpezar.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.062745, 0.211765, 0.266667, 1)
boot_splash/use_filter=false
boot_splash/image="res://Assets/UI/fondo_titulo.png"
config/icon="res://Assets/UI/icono_juego.png"

[audio]

general/default_playback_type.web=0

[autoload]

Estado="*res://Autoload/Estado.gd"
Flujo="*res://Autoload/Flujo.gd"
Retroalimentacion="*res://Autoload/Retroalimentacion.gd"
Sismo="*res://Autoload/Sismo.gd"
DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"
Dialogo="*res://Autoload/Dialogo.gd"
Notificacion="*res://Autoload/Notificacion.gd"
Opciones="*res://Autoload/Opciones.gd"
Audio="*res://Autoload/Audio.gd"
Guardado="*res://Autoload/Guardado.gd"
Menus="*res://Autoload/Menus.gd"
Evaluacion="*res://Autoload/Evaluacion.gd"
Depuracion="*res://Autoload/Depuracion.gd"
Reportes="*res://Autoload/Reportes.gd"

[dialogue_manager]

runtime/balloon_path="res://Scenes/UI/DialogoBalloon.tscn"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"
window/stretch/scale_mode.web="fractional"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg")

[gui]

theme/custom="res://Resources/tema_minutocero.tres"

